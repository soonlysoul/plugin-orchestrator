{
  "permissions": {
    "allow": [
      "Bash(git --version)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(jq --version)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh repo view)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list)",
      "Bash(gh workflow view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add --all*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)",
      "Bash(gh run rerun *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./.forge/config.yaml)"
    ]
  }
}
